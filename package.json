{
  "name": "lobby-db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema and migrations (infra-only scaffold, no application code yet)",
  "scripts": {
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
