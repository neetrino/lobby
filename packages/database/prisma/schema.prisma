generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 keeps connection URLs in prisma.config.ts instead of this schema.
}

/// Current foundation allows only the starter plan. Additional plans need a product decision.
enum TenantPlan {
  STARTER @map("starter")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

/// Shared-database tenant root. Row-Level Security is not enabled.
/// `current_tenant_id()` is a SQL helper for a future policy, not a column.
model Tenant {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  subdomain                String                     @unique
  plan                     TenantPlan
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  users                    User[]
  tenantModules            TenantModule[]
  contacts                      Contact[]
  outboxEvents                  OutboxEvent[]
  reservationLocations          ReservationLocation[]
  reservationTables             ReservationTable[]
  reservationWorkingHours       ReservationWorkingHours[]
  reservationScheduleExceptions ReservationScheduleException[]
  reservations                  Reservation[]
  reservationSourceRequests     ReservationSourceRequest[]
  reservationChannels           ReservationChannel[]
  reservationStatusHistory      ReservationStatusHistory[]
  auditEvents              AuditEvent[]
  memberInvitations        MemberInvitation[]
  passwordResets           PasswordReset[]
  dashboardLayouts         UserDashboardLayout[]
  pipelines                Pipeline[]
  pipelineColumns          PipelineColumn[]
  pipelineCards            PipelineCard[]
  pipelineStatuses         PipelineStatus[]
  pipelineCardMessages     PipelineCardMessage[]
  pipelineCardNotes        PipelineCardNote[]
  directConversations      DirectConversation[]
  directMessages           DirectMessage[]

  @@map("tenants")
}

/// Tenant member identity. Email is unique inside one tenant, not globally.
/// One user row belongs to exactly one tenant. There is no membership join.
model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  email                 String
  name                  String
  passwordHash          String     @map("password_hash")
  status                UserStatus @default(ACTIVE)
  role                  TenantRole
  authenticationVersion Int        @default(1) @map("authentication_version")
  passwordChangedAt     DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  leadsEnabled          Boolean    @default(true) @map("leads_enabled")
  jobTitle              String?    @map("job_title")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedReservations     Reservation[]              @relation("ReservationAssignedUser")
  createdReservations      Reservation[]              @relation("ReservationCreatedByUser")
  reservationStatusChanges ReservationStatusHistory[]
  auditEvents              AuditEvent[]
  createdContacts          Contact[]                  @relation("ContactCreatedBy")
  ownedContacts            Contact[]                  @relation("ContactOwner")
  memberInvitations        MemberInvitation[]         @relation("MemberInvitationInvitedBy")
  passwordResets           PasswordReset[]
  dashboardLayout          UserDashboardLayout?
  ownedPipelineCards       PipelineCard[]             @relation("PipelineCardOwner")
  createdPipelineCards     PipelineCard[]             @relation("PipelineCardCreator")
  pipelineCardMessages     PipelineCardMessage[]
  pipelineCardNotes        PipelineCardNote[]
  directMessages           DirectMessage[]
  directConversationsLow   DirectConversation[] @relation("DirectConversationLow")
  directConversationsHigh  DirectConversation[] @relation("DirectConversationHigh")

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@map("users")
}

enum TenantModuleStatus {
  ENABLED
  DISABLED
}

/// Tenant opt-in for an optional product module. A missing row is disabled.
model TenantModule {
  tenantId  String             @map("tenant_id") @db.Uuid
  moduleKey String             @map("module_key")
  status    TenantModuleStatus
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tenantId, moduleKey])
  @@map("tenant_modules")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AuditActorType {
  USER
  INTEGRATION
}

/// Append-only security and business history. Application code inserts and reads.
model AuditEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  actorRole     TenantRole?    @map("actor_role")
  actorType     AuditActorType @map("actor_type")
  action        String
  resourceType  String         @map("resource_type")
  resourceId    String         @map("resource_id") @db.Uuid
  outcome       AuditOutcome
  changes       Json?
  reason        String?
  requestId     String         @map("request_id") @db.Uuid
  ipHash        String?        @map("ip_hash")
  userAgent     String?        @map("user_agent")
  schemaVersion Int            @default(1) @map("schema_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor  User?  @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, occurredAt, id])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorUserId])
  @@map("audit_events")
}

/// One-time tenant invitation. The raw token is never stored.
/// A row is open only while it is unaccepted, unrevoked, and unexpired.
model MemberInvitation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  email       String
  role        TenantRole @default(MEMBER)
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  invitedById String     @map("invited_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy User   @relation("MemberInvitationInvitedBy", fields: [invitedById, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, email])
  @@map("member_invitations")
}

/// One-time password reset. The raw token is not a column.
model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, userId])
  @@map("password_resets")
}

/// Per-user dashboard layout. The dashboard module owns this table and does not store other modules' facts here.
model UserDashboardLayout {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rangeDays   Int      @default(30) @map("range_days")
  scope       String   @default("all")
  customized  Boolean  @default(false)
  widgetOrder String[] @default([]) @map("widget_order")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, tenantId])
  @@map("user_dashboard_layouts")
}

enum ContactType {
  PERSON
  ORGANIZATION
}

/// Tenant-owned contact. Only the Contacts module writes this table.
/// `email` is unique inside the tenant, including archived rows. Null emails may repeat.
model Contact {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  name            String
  type            ContactType @default(PERSON)
  email           String?
  phone           String?
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  ownerUserId     String      @map("owner_user_id") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User          @relation("ContactCreatedBy", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  owner        User          @relation("ContactOwner", fields: [ownerUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  reservations Reservation[]
  pipelineCards PipelineCard[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId, name, id])
  @@map("contacts")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventType     String            @map("event_type")
  eventVersion  Int               @map("event_version")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  occurredAt    DateTime          @map("occurred_at") @db.Timestamptz(3)
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts      Int               @default(0)
  lockedAt      DateTime?         @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?           @map("locked_by")
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([tenantId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Durable record that an external effect must not run again.
/// Reserve-before handlers insert before the call. Invitation email inserts after the provider accepts it.
model ProcessedEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  handlerName  String   @map("handler_name")
  eventType    String   @map("event_type")
  eventVersion Int      @map("event_version")
  eventId      String   @map("event_id") @db.Uuid
  reservedAt   DateTime @default(now()) @map("reserved_at") @db.Timestamptz(3)

  @@unique([handlerName, eventType, eventVersion, eventId], map: "processed_events_handler_event_key")
  @@map("processed_events")
}

enum ReservationLocationStatus {
  ACTIVE
  INACTIVE
}

enum ReservationTableStatus {
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  STAFF
  WEBSITE
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  PHONE
  WALK_IN
}

/// Branch of a restaurant or cafe. `timezone` is an IANA name, such as Asia/Yerevan.
model ReservationLocation {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                    @map("tenant_id") @db.Uuid
  name      String
  timezone  String
  address   String?
  status    ReservationLocationStatus @default(ACTIVE)
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tables       ReservationTable[]
  workingHours ReservationWorkingHours[]
  exceptions   ReservationScheduleException[]
  reservations Reservation[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("reservation_locations")
}

/// Physical table that can be booked. Capacity is 1–100 and at least `minCapacity`.
model ReservationTable {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  locationId  String                 @map("location_id") @db.Uuid
  name        String
  minCapacity Int                    @default(1) @map("min_capacity")
  capacity    Int
  status      ReservationTableStatus @default(ACTIVE)
  archivedAt  DateTime?              @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location     ReservationLocation @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  reservations Reservation[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, locationId])
  @@unique([tenantId, locationId, name])
  @@index([tenantId, locationId, status])
  @@map("reservation_tables")
}

/// Weekly hours in the location timezone. Weekday 0 is Sunday.
/// When the location is open and `closesAt` is earlier than `opensAt`, service continues past midnight.
model ReservationWorkingHours {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  weekday    Int
  opensAt    DateTime @map("opens_at") @db.Time(0)
  closesAt   DateTime @map("closes_at") @db.Time(0)
  isClosed   Boolean  @default(false) @map("is_closed")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location ReservationLocation @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, locationId, weekday])
  @@map("reservation_working_hours")
}

/// One local calendar day that replaces the weekly hours. Closed days store no times.
/// An open exception uses the same overnight rule as weekly hours.
model ReservationScheduleException {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  localDate  DateTime  @map("local_date") @db.Date
  opensAt    DateTime? @map("opens_at") @db.Time(0)
  closesAt   DateTime? @map("closes_at") @db.Time(0)
  isClosed   Boolean   @default(false) @map("is_closed")
  note       String?

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location ReservationLocation @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, locationId, localDate])
  @@map("reservation_schedule_exceptions")
}

/// One booking. `startsAt` and `endsAt` are UTC. A table, when set, belongs to this location.
model Reservation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  locationId          String            @map("location_id") @db.Uuid
  tableId             String?           @map("table_id") @db.Uuid
  contactId           String?           @map("contact_id") @db.Uuid
  assignedUserId      String?           @map("assigned_user_id") @db.Uuid
  createdByUserId     String?           @map("created_by_user_id") @db.Uuid
  status              ReservationStatus @default(PENDING)
  source              ReservationSource
  guestCount          Int               @map("guest_count")
  startsAt            DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime          @map("ends_at") @db.Timestamptz(3)
  customerName        String            @map("customer_name")
  customerPhone       String?           @map("customer_phone")
  customerEmail       String?           @map("customer_email")
  customerNote        String?           @map("customer_note")
  internalNote        String?           @map("internal_note")
  /// External account id, such as a WhatsApp or Telegram account. Same text as the source-request row.
  sourceAccountId     String?           @map("source_account_id")
  sourceRequestId     String?           @map("source_request_id")
  sourceConversationId String?          @map("source_conversation_id")
  sourceMessageId     String?           @map("source_message_id")
  confirmedAt         DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  arrivedAt           DateTime?         @map("arrived_at") @db.Timestamptz(3)
  seatedAt            DateTime?         @map("seated_at") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location      ReservationLocation        @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  table         ReservationTable?          @relation(fields: [tableId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict, onUpdate: Cascade)
  contact       Contact?                   @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  assignedUser  User?                      @relation("ReservationAssignedUser", fields: [assignedUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User?                      @relation("ReservationCreatedByUser", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  sourceRequests ReservationSourceRequest[]
  statusHistory  ReservationStatusHistory[]

  @@unique([id, tenantId])
  @@index([tenantId, locationId, startsAt])
  @@index([tenantId, contactId, startsAt])
  @@index([tenantId, assignedUserId, startsAt])
  @@map("reservations")
}

/// Webhook identity for one channel account. The raw secret is not stored.
/// Authentication hashes the presented credential and reads tenant, provider, and account from this row.
model ReservationChannel {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  provider         ReservationSource
  channelAccountId String            @map("channel_account_id")
  credentialHash   String            @unique @map("credential_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, provider, channelAccountId], map: "reservation_channels_account_key")
  @@map("reservation_channels")
}

/// Deduplicates a channel webhook. The same external request cannot create a second booking.
/// `requestFingerprint` is the SHA-256 of a fixed-order JSON array of the original command. Later reservation edits do not change it.
model ReservationSourceRequest {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  source              ReservationSource
  sourceAccountId     String            @map("source_account_id")
  externalRequestId   String            @map("external_request_id")
  reservationId       String            @map("reservation_id") @db.Uuid
  requestFingerprint  String            @map("request_fingerprint")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, source, sourceAccountId, externalRequestId])
  @@index([tenantId, reservationId])
  @@map("reservation_source_requests")
}

/// Business timeline of one booking. This is not the security audit log.
model ReservationStatusHistory {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  reservationId   String             @map("reservation_id") @db.Uuid
  fromStatus      ReservationStatus? @map("from_status")
  toStatus        ReservationStatus  @map("to_status")
  changedByUserId String?            @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation @relation(fields: [reservationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  changedBy   User?       @relation(fields: [changedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, reservationId, createdAt])
  @@map("reservation_status_history")
}

enum PipelineKind {
  LEAD
  DEAL
}

/// One lead board and one deal board per tenant. Stage names belong to the tenant.
model Pipeline {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  kind        PipelineKind
  name        String
  amountLabel String       @default("") @map("amount_label")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  columns PipelineColumn[]
  cards   PipelineCard[]

  @@unique([tenantId, kind])
  @@unique([id, tenantId])
  @@map("pipelines")
}

/// Tenant-defined kanban column. Width is in pixels and stays inside 220–640.
model PipelineColumn {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  name       String
  position   Int
  widthPx    Int      @default(300) @map("width_px")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pipeline Pipeline       @relation(fields: [pipelineId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  cards    PipelineCard[]

  @@unique([pipelineId, position])
  @@unique([id, tenantId])
  @@unique([id, pipelineId, tenantId])
  @@index([tenantId, pipelineId])
  @@map("pipeline_columns")
}

enum PipelineCardOutcome {
  OPEN
  WON
  LOST
  DISQUALIFIED
  CONVERTED
}

enum PipelineCardPriority {
  NORMAL
  URGENT
}

/// Tenant-defined team label. Name and color are chosen by Owner and Admin.
model PipelineStatus {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cards  PipelineCard[]

  @@unique([tenantId, name])
  @@unique([tenantId, position])
  @@unique([id, tenantId])
  @@map("pipeline_statuses")
}

/// A lead or deal card. Amount is a PostgreSQL integer until a currency decimal is introduced.
model PipelineCard {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  pipelineId       String              @map("pipeline_id") @db.Uuid
  columnId         String              @map("column_id") @db.Uuid
  title            String
  company          String              @default("")
  amount           Int                 @default(0)
  position         Int
  source           String              @default("")
  qualification    String              @default("")
  nextAction       String              @default("") @map("next_action")
  lostReason       String              @default("") @map("lost_reason")
  outcome          PipelineCardOutcome @default(OPEN)
  priority         PipelineCardPriority @default(NORMAL)
  expectedCloseOn  DateTime?           @map("expected_close_on") @db.Date
  contactId        String?             @map("contact_id") @db.Uuid
  ownerUserId      String?             @map("owner_user_id") @db.Uuid
  createdByUserId  String?             @map("created_by_user_id") @db.Uuid
  statusId         String?             @map("status_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pipeline  Pipeline        @relation(fields: [pipelineId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  column    PipelineColumn  @relation(fields: [columnId, pipelineId, tenantId], references: [id, pipelineId, tenantId], onDelete: Restrict, onUpdate: Cascade)
  contact   Contact?        @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  owner     User?           @relation("PipelineCardOwner", fields: [ownerUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?           @relation("PipelineCardCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  status    PipelineStatus? @relation(fields: [statusId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  messages  PipelineCardMessage[]
  notes     PipelineCardNote[]

  @@unique([id, tenantId])
  @@unique([columnId, position])
  @@index([tenantId, columnId, position])
  @@index([tenantId, statusId])
  @@map("pipeline_cards")
}

/// Tenant-internal discussion attached to one lead or deal card.
model PipelineCardMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  card   PipelineCard @relation(fields: [cardId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  author User         @relation(fields: [authorUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, cardId, createdAt, id])
  @@map("pipeline_card_messages")
}

/// Shared internal note attached to one lead or deal card.
model PipelineCardNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  card   PipelineCard @relation(fields: [cardId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  author User         @relation(fields: [authorUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, cardId, createdAt, id])
  @@map("pipeline_card_notes")
}

/// One private thread for two users of the same tenant. The pair is stored in id order.
model DirectConversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userLowId  String   @map("user_low_id") @db.Uuid
  userHighId String   @map("user_high_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userLow  User            @relation("DirectConversationLow", fields: [userLowId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  userHigh User            @relation("DirectConversationHigh", fields: [userHighId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  messages DirectMessage[]

  @@unique([id, tenantId])
  @@unique([tenantId, userLowId, userHighId])
  @@map("direct_conversations")
}

/// Message inside a two-person thread. Only those two users can read or write it.
model DirectMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversation DirectConversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  author       User               @relation(fields: [authorUserId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, conversationId, createdAt, id])
  @@map("direct_messages")
}
