
# Application
NODE_ENV="development"
# API listen port. Default 3001. Invalid values fail startup.
PORT="3001"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL=""
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"


# Public registration stays closed unless this is exactly true.
REGISTRATION_ENABLED="false"

# Browser origins allowed to call the API with cookies. Comma-separated. No wildcard.
# When unset, APP_URL is the only origin. CORS is not CSRF protection.
ALLOWED_ORIGINS="http://localhost:3000"

# Auth rate limits. The attempt after this many in the window returns 429 RATE_LIMITED.
RATE_LIMIT_LOGIN_IP_LIMIT="20"
RATE_LIMIT_LOGIN_IP_WINDOW_MS="900000"
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT="10"
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS="900000"
RATE_LIMIT_REGISTER_IP_LIMIT="5"
RATE_LIMIT_REGISTER_IP_WINDOW_MS="3600000"
RATE_LIMIT_INVALID_SESSION_IP_LIMIT="30"
RATE_LIMIT_INVALID_SESSION_IP_WINDOW_MS="300000"

# ——— Cache (Upstash Redis) ———
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""
# Upstash timeout for session and rate-limit commands, in milliseconds. Default 3000. Maximum 30000.
SESSION_REDIS_TIMEOUT_MS="3000"
# Off by default. Production: proxy IP or CIDR allowlist. A hop count is only safe when every request crosses that many proxies. true is rejected.
TRUST_PROXY="false"


# ——— Email (Resend) ———
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="test@neetrino.com"

# ——— File storage (Cloudflare R2) ———
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ——— Figma (MCP) ———
FIGMA_ACCESS_TOKEN=""
